<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VibeConnect - Nearby Friends</title>
  <style>
    :root {
      --bg: #0f1115;
      --card: #1a1d24;
      --accent: #ff9f1c;
      --online: #2ec4b6;
      --danger: #e71d36;
      --warn: #ffb703;
      --text: #f5f7fa;
      --muted: #9aa0a6;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      padding-bottom: 80px;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(15, 17, 21, 0.96);
      backdrop-filter: blur(8px);
      padding: 12px 14px;
      border-bottom: 1px solid #262a34;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .brand {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--accent);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .status-pill {
      font-size: 0.75rem;
      padding: 4px 8px;
      border-radius: 999px;
      font-weight: 700;
      background: rgba(255, 183, 3, 0.16);
      color: var(--warn);
      border: 1px solid rgba(255, 183, 3, 0.4);
    }

    .status-pill.verified {
      background: rgba(46, 196, 182, 0.16);
      color: var(--online);
      border-color: rgba(46, 196, 182, 0.4);
    }

    .status-pill.rejected {
      background: rgba(231, 29, 54, 0.16);
      color: var(--danger);
      border-color: rgba(231, 29, 54, 0.4);
    }

    .owner-btn {
      background: #262a34;
      color: #fff;
      border: 1px solid #383e4d;
      padding: 5px 10px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .quota-bar {
      background: #14171d;
      border-bottom: 1px solid #222630;
      padding: 8px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .quota-bar strong {
      color: var(--text);
    }

    .upgrade-link {
      background: var(--accent);
      color: #000;
      border: none;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.76rem;
      font-weight: 800;
      cursor: pointer;
    }

    .filters {
      display: flex;
      gap: 8px;
      padding: 10px 14px;
      overflow-x: auto;
      background: #14171d;
    }

    .chip {
      background: var(--card);
      color: var(--text);
      border: 1px solid #2c313d;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.84rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .chip.active {
      background: var(--accent);
      color: #000;
      font-weight: 700;
      border-color: var(--accent);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      padding: 4px;
    }

    .tile {
      position: relative;
      aspect-ratio: 1 / 1.15;
      background: var(--card);
      overflow: hidden;
      cursor: pointer;
    }

    .tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .tile-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 12%, transparent 58%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 8px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 5px;
    }

    .online { background: var(--online); box-shadow: 0 0 6px var(--online); }
    .offline { background: #6c757d; }

    .tile-name {
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tile-dist {
      font-size: 0.72rem;
      color: var(--muted);
    }

    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #14171d;
      border-top: 1px solid #262a34;
      display: flex;
      justify-content: space-around;
      padding: 10px 0;
      z-index: 15;
    }

    .nav-btn {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
    }

    .nav-btn.active {
      color: var(--accent);
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.88);
      z-index: 30;
      display: none;
      flex-direction: column;
    }

    .modal.open {
      display: flex;
    }

    .modal-header {
      padding: 14px 16px;
      background: #14171d;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #262a34;
    }

    .close-btn {
      background: #262a34;
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
    }

    .modal-body {
      padding: 16px;
      overflow-y: auto;
      flex: 1;
    }

    .profile-pic {
      width: 100%;
      max-height: 300px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 12px;
    }

    .badge {
      display: inline-block;
      background: #262a34;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 0.78rem;
      margin: 4px 4px 10px 0;
      color: var(--accent);
    }

    .action-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 14px;
    }

    .btn {
      padding: 12px;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
    }

    .btn-primary { background: var(--accent); color: #000; }
    .btn-secondary { background: #262a34; color: #fff; }
    .btn-success { background: var(--online); color: #000; }
    .btn-danger {
      background: rgba(231, 29, 54, 0.16);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    .lock-banner {
      background: rgba(255, 183, 3, 0.12);
      border: 1px solid rgba(255, 183, 3, 0.45);
      color: #ffd166;
      padding: 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      line-height: 1.45;
      margin-bottom: 12px;
    }

    .chat-messages {
      flex: 1;
      padding: 14px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .msg {
      max-width: 78%;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .msg.them {
      background: var(--card);
      align-self: flex-start;
    }

    .msg.me {
      background: var(--accent);
      color: #000;
      align-self: flex-end;
      font-weight: 500;
    }

    .chat-input-bar {
      display: flex;
      gap: 8px;
      padding: 10px 12px;
      background: #14171d;
      border-top: 1px solid #262a34;
    }

    .chat-input-bar input {
      flex: 1;
      background: var(--card);
      border: 1px solid #2c313d;
      color: #fff;
      padding: 10px 12px;
      border-radius: 20px;
      outline: none;
    }

    .section-view { display: none; padding: 14px; }
    .section-view.active { display: block; }

    .card-box {
      background: var(--card);
      border: 1px solid #272c38;
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 14px;
    }

    .form-group { margin-bottom: 12px; }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      color: var(--muted);
      margin-bottom: 5px;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      background: #12151b;
      border: 1px solid #2c313d;
      color: #fff;
      padding: 10px;
      border-radius: 8px;
      font-size: 0.9rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid #272c38;
      border-radius: 10px;
      padding: 10px;
      text-align: center;
    }

    .stat-num {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--accent);
    }

    .stat-label {
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .pay-option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #12151b;
      border: 1px solid #2c313d;
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 10px;
      cursor: pointer;
    }

    .pay-option.selected {
      border-color: var(--accent);
      background: rgba(255, 159, 28, 0.08);
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">VibeConnect</div>
    <div class="header-right">
      <span id="headerStatusBadge" class="status-pill">Pending</span>
      <button class="owner-btn" onclick="openOwnerLogin()">Owner</button>
    </div>
  </header>

  <div class="quota-bar">
    <div>
      Free (≤10 km): <strong id="freeCounter">0 / 40</strong> ·
      Plan: <strong id="planStatusText">Free</strong>
    </div>
    <button class="upgrade-link" onclick="openPayModal()">₹250 / Week</button>
  </div>

  <!-- NEARBY TAB -->
  <div id="tab-nearby">
    <div class="filters">
      <button class="chip active" onclick="setFilter('all', this)">All (≤10 km)</button>
      <button class="chip" onclick="setFilter('online', this)">Online Now</button>
      <button class="chip" onclick="setFilter('under2', this)">Under 2 km</button>
    </div>
    <div class="grid" id="userGrid"></div>
  </div>

  <!-- CHATS TAB -->
  <div id="tab-chats" class="section-view">
    <h3 style="margin-bottom: 10px;">Messages</h3>
    <div id="chatLockNotice" class="lock-banner" style="display:none;">
      🔒 <strong>Chat Sending Locked (Status: Pending):</strong> Aap app ke baaki sabhi features use kar sakte hain, lekin message bhejne ke liye Owner se account verify hona zaroori hai.
    </div>
    <div id="inboxList"></div>
  </div>

  <!-- MY PROFILE & VERIFICATION TAB -->
  <div id="tab-me" class="section-view">
    <h3 style="margin-bottom: 12px;">Profile & Face + ID Verification</h3>

    <div class="card-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <strong>Verification Status</strong>
        <span id="profileStatusBadge" class="status-pill">Pending</span>
      </div>
      <p style="font-size:0.83rem; color:var(--muted); line-height:1.45;">
        Pending status mein bhi aap Nearby grid, profiles aur plans poori tarah use kar sakte hain. Sirf message bhejne ki suvidha Owner approval ke baad khulti hai.
      </p>

      <div class="form-group" style="margin-top:12px;">
        <label>Display Name</label>
        <input type="text" id="myName" value="Preet" />
      </div>
      <div class="form-group">
        <label>Indian ID Type</label>
        <select id="idType">
          <option value="Aadhaar">Aadhaar Card</option>
          <option value="PAN">PAN Card</option>
          <option value="Driving Licence">Driving Licence</option>
          <option value="Voter ID">Voter ID</option>
        </select>
      </div>
      <div class="form-group">
        <label>Indian ID Number (Last 4 / Reference)</label>
        <input type="text" id="idNumber" placeholder="e.g. XXXX-XXXX-1234" />
      </div>
      <div class="form-group">
        <label>Live Face Selfie Photo</label>
        <input type="file" id="selfieInput" accept="image/*" capture="user" />
      </div>
      <div class="form-group">
        <label>Indian ID Document Photo</label>
        <input type="file" id="idDocInput" accept="image/*" />
      </div>
      <button class="btn btn-primary" style="width:100%;" onclick="submitVerification()">
        Submit for Owner Verification (Set Pending)
      </button>
    </div>
  </div>

  <!-- BOTTOM NAV -->
  <nav>
    <button class="nav-btn active" onclick="switchTab('nearby', this)">Nearby</button>
    <button class="nav-btn" onclick="switchTab('chats', this)">Chats</button>
    <button class="nav-btn" onclick="switchTab('me', this)">Verify / Me</button>
  </nav>

  <!-- PROFILE MODAL -->
  <div class="modal" id="profileModal">
    <div class="modal-header">
      <strong id="modalTitle">Profile</strong>
      <button class="close-btn" onclick="closeModal('profileModal')">Close</button>
    </div>
    <div class="modal-body" id="profileContent"></div>
  </div>

  <!-- CHAT MODAL -->
  <div class="modal" id="chatModal">
    <div class="modal-header">
      <strong id="chatWithTitle">Chat</strong>
      <button class="close-btn" onclick="closeModal('chatModal')">Back</button>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div id="modalChatLock" class="lock-banner" style="margin: 0 12px 10px; display:none;">
      Status <strong>Pending</strong> hai — aap chat screen dekh sakte hain, lekin message send karne ke liye Owner approval chahiye.
    </div>
    <div class="chat-input-bar">
      <input type="text" id="msgInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendMessage()" />
      <button class="btn btn-primary" style="padding: 8px 16px; border-radius: 20px;" onclick="sendMessage()">Send</button>
    </div>
  </div>

  <!-- PAYMENT MODAL (₹250 / 600 Profiles / 1 Week) -->
  <div class="modal" id="payModal">
    <div class="modal-header">
      <strong>Unlock 600 Profiles · ₹250 / Week</strong>
      <button class="close-btn" onclick="closeModal('payModal')">Close</button>
    </div>
    <div class="modal-body">
      <div class="card-box">
        <h4 style="color:var(--accent); margin-bottom:6px;">Weekly Pass — ₹250</h4>
        <p style="font-size:0.84rem; color:var(--muted); line-height:1.45;">
          10 km ke andar 40 profiles free hain. Is plan se 7 din (1 Week) ke liye 600 profiles unlock hongi.
        </p>
      </div>

      <div class="pay-option selected" id="opt-upi" onclick="selectPayMethod('UPI')">
        <div>
          <strong>UPI Payment</strong>
          <div style="font-size:0.78rem; color:var(--muted);">GPay, PhonePe, Paytm, BHIM UPI</div>
        </div>
        <span>●</span>
      </div>

      <div class="pay-option" id="opt-card" onclick="selectPayMethod('Debit / Credit Card')">
        <div>
          <strong>Debit / Credit Card</strong>
          <div style="font-size:0.78rem; color:var(--muted);">Visa, Mastercard, RuPay</div>
        </div>
        <span>○</span>
      </div>

      <div class="form-group" id="payInputBox">
        <label id="payInputLabel">Enter UPI ID</label>
        <input type="text" id="payDetailInput" placeholder="example@okaxis" />
      </div>

      <button class="btn btn-primary" style="width:100%;" onclick="activateWeeklyPlan()">
        Pay ₹250 & Activate 600 Profiles (1 Week)
      </button>
    </div>
  </div>

  <!-- OWNER PANEL MODAL -->
  <div class="modal" id="ownerModal">
    <div class="modal-header">
      <strong>Owner Panel — Verification & Users</strong>
      <button class="close-btn" onclick="closeModal('ownerModal')">Close</button>
    </div>
    <div class="modal-body">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-num" id="statTotalUsers">1</div>
          <div class="stat-label">Total Users</div>
        </div>
        <div class="stat-card">
          <div class="stat-num" id="statStatus">Pending</div>
          <div class="stat-label">Current Status</div>
        </div>
        <div class="stat-card">
          <div class="stat-num" id="statPaid">No</div>
          <div class="stat-label">₹250 Plan</div>
        </div>
      </div>

      <div class="card-box" id="ownerUserCard"></div>
    </div>
  </div>

  <script>
    const OWNER_PIN = "1234"; // Apna PIN yahan badal sakte hain

    // 40 profiles generated within 10 km for demo testing
    const profilesPool = Array.from({ length: 45 }, (_, idx) => {
      const i = idx + 1;
      const dist = Number((Math.min(9.8, i * 0.22)).toFixed(1));
      return {
        id: i,
        name: `User ${i}`,
        age: 22 + (i % 15),
        dist,
        online: i % 2 === 0,
        tag: i % 3 === 0 ? "Coffee & Drives" : i % 2 === 0 ? "Hangout" : "Networking",
        bio: `Local member around ${dist} km away. Open for friendly chat and meetups.`,
        img: `https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&q=75&sig=${i}`
      };
    });

    let userAccount = JSON.parse(localStorage.getItem("vc_account_v1") || JSON.stringify({
      name: "Preet",
      idType: "Aadhaar",
      idNumber: "",
      verificationStatus: "Pending", // Pending | Verified | Rejected
      viewedProfileIds: [],
      hasWeeklyPlan: false,
      planLimit: 40,
      paymentMethod: "UPI"
    }));

    let chats = JSON.parse(localStorage.getItem("vc_chats_v1") || "{}");
    let currentFilter = "all";
    let activeChatUser = null;
    let selectedPayMethod = "UPI";

    function saveAccount() {
      localStorage.setItem("vc_account_v1", JSON.stringify(userAccount));
      updateTopUI();
    }

    function updateTopUI() {
      const status = userAccount.verificationStatus;
      const badgeClass = `status-pill ${status === "Verified" ? "verified" : status === "Rejected" ? "rejected" : ""}`;

      ["headerStatusBadge", "profileStatusBadge"].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.className = badgeClass;
          el.innerText = status;
        }
      });

      const maxAllowed = userAccount.hasWeeklyPlan ? 600 : 40;
      const usedCount = userAccount.viewedProfileIds.length;
      document.getElementById("freeCounter").innerText = `${usedCount} / ${maxAllowed}`;
      document.getElementById("planStatusText").innerText = userAccount.hasWeeklyPlan ? "₹250 (600/Wk)" : "Free (40)";
    }

    function renderGrid() {
      const grid = document.getElementById("userGrid");
      grid.innerHTML = "";

      const list = profilesPool.filter(u => {
        if (u.dist > 10) return false;
        if (currentFilter === "online") return u.online;
        if (currentFilter === "under2") return u.dist <= 2.0;
        return true;
      });

      list.forEach(user => {
        const div = document.createElement("div");
        div.className = "tile";
        div.onclick = () => handleProfileClick(user);
        div.innerHTML = `
          <img src="${user.img}" alt="${user.name}" />
          <div class="tile-overlay">
            <div class="tile-name">
              <span class="status-dot ${user.online ? 'online' : 'offline'}"></span>${user.name}, ${user.age}
            </div>
            <div class="tile-dist">${user.dist} km away</div>
          </div>
        `;
        grid.appendChild(div);
      });
    }

    function handleProfileClick(user) {
      const maxAllowed = userAccount.hasWeeklyPlan ? 600 : 40;
      const alreadyViewed = userAccount.viewedProfileIds.includes(user.id);

      if (!alreadyViewed && userAccount.viewedProfileIds.length >= maxAllowed) {
        openPayModal();
        return;
      }

      if (!alreadyViewed) {
        userAccount.viewedProfileIds.push(user.id);
        saveAccount();
      }

      openProfileModal(user);
    }

    function openProfileModal(user) {
      document.getElementById("modalTitle").innerText = `${user.name}, ${user.age}`;
      document.getElementById("profileContent").innerHTML = `
        <img class="profile-pic" src="${user.img}" alt="${user.name}" />
        <div>
          <span class="badge">${user.online ? "● Online Now" : "Offline"}</span>
          <span class="badge">📍 ${user.dist} km away</span>
          <span class="badge">${user.tag}</span>
        </div>
        <p style="margin-top: 8px; line-height: 1.5; color: #ddd;">${user.bio}</p>
        <div class="action-row">
          <button class="btn btn-secondary" onclick="sendWave(${user.id}, '${user.name}')">👋 Send Wave</button>
          <button class="btn btn-primary" onclick="startChat(${user.id})">💬 Open Chat</button>
        </div>
      `;
      document.getElementById("profileModal").classList.add("open");
    }

    function sendWave(id, name) {
      if (!chats[id]) chats[id] = [];
      chats[id].push({ sender: "me", text: "👋 Sent a wave!" });
      localStorage.setItem("vc_chats_v1", JSON.stringify(chats));
      alert(`Wave sent to ${name}!`);
    }

    function startChat(userId) {
      closeModal("profileModal");
      activeChatUser = profilesPool.find(u => u.id === userId);
      document.getElementById("chatWithTitle").innerText = activeChatUser.name;
      if (!chats[userId]) {
        chats[userId] = [{ sender: "them", text: `Hey! Nearby here around ${activeChatUser.dist} km.` }];
        localStorage.setItem("vc_chats_v1", JSON.stringify(chats));
      }
      renderMessages();
      const canSend = userAccount.verificationStatus === "Verified";
      document.getElementById("modalChatLock").style.display = canSend ? "none" : "block";
      document.getElementById("chatModal").classList.add("open");
    }

    function renderMessages() {
      const box = document.getElementById("chatMessages");
      box.innerHTML = "";
      const list = chats[activeChatUser.id] || [];
      list.forEach(m => {
        const div = document.createElement("div");
        div.className = `msg ${m.sender}`;
        div.innerText = m.text;
        box.appendChild(div);
      });
      box.scrollTop = box.scrollHeight;
    }

    function sendMessage() {
      if (userAccount.verificationStatus !== "Verified") {
        alert("Aapka status abhi Pending hai. Aap app ke baaki sabhi features use kar sakte hain, lekin message bhejne ke liye Owner se approval zaroori hai.");
        return;
      }

      const input = document.getElementById("msgInput");
      const text = input.value.trim();
      if (!text || !activeChatUser) return;

      chats[activeChatUser.id].push({ sender: "me", text });
      input.value = "";
      localStorage.setItem("vc_chats_v1", JSON.stringify(chats));
      renderMessages();
    }

    function renderInbox() {
      const canSend = userAccount.verificationStatus === "Verified";
      document.getElementById("chatLockNotice").style.display = canSend ? "none" : "block";

      const list = document.getElementById("inboxList");
      list.innerHTML = "";
      const ids = Object.keys(chats).map(Number);

      if (ids.length === 0) {
        list.innerHTML = `<p style="color: var(--muted); font-size:0.88rem;">Koi active chat nahi hai. Kisi bhi nearby profile par tap karke chat khol sakte hain (message bhejne ke liye Owner approval chahiye).</p>`;
        return;
      }

      ids.forEach(id => {
        const u = profilesPool.find(x => x.id === id);
        if (!u) return;
        const lastMsg = chats[id][chats[id].length - 1]?.text || "";
        const item = document.createElement("div");
        item.className = "card-box";
        item.style.cursor = "pointer";
        item.onclick = () => startChat(id);
        item.innerHTML = `<strong>${u.name}</strong><div style="font-size:0.82rem; color:var(--muted); margin-top:4px;">${lastMsg}</div>`;
        list.appendChild(item);
      });
    }

    function submitVerification() {
      userAccount.name = document.getElementById("myName").value.trim() || "User";
      userAccount.idType = document.getElementById("idType").value;
      userAccount.idNumber = document.getElementById("idNumber").value.trim();
      userAccount.verificationStatus = "Pending";
      saveAccount();
      alert("Details submit ho gayi hain. Status abhi Pending hai — aap app use kar sakte hain, aur Owner ke approve karte hi messaging shuru ho jayegi.");
    }

    function selectPayMethod(method) {
      selectedPayMethod = method;
      document.getElementById("opt-upi").classList.toggle("selected", method === "UPI");
      document.getElementById("opt-card").classList.toggle("selected", method !== "UPI");
      document.getElementById("opt-upi").querySelector("span:last-child").innerText = method === "UPI" ? "●" : "○";
      document.getElementById("opt-card").querySelector("span:last-child").innerText = method !== "UPI" ? "●" : "○";

      if (method === "UPI") {
        document.getElementById("payInputLabel").innerText = "Enter UPI ID";
        document.getElementById("payDetailInput").placeholder = "example@okaxis";
      } else {
        document.getElementById("payInputLabel").innerText = "Card Number (Demo)";
        document.getElementById("payDetailInput").placeholder = "XXXX XXXX XXXX 4242";
      }
    }

    function activateWeeklyPlan() {
      userAccount.hasWeeklyPlan = true;
      userAccount.planLimit = 600;
      userAccount.paymentMethod = selectedPayMethod;
      saveAccount();
      closeModal("payModal");
      alert(`₹250 plan (${selectedPayMethod}) active ho gaya hai! Ab 600 profiles (1 week) tak access open hai.`);
    }

    function openPayModal() {
      document.getElementById("payModal").classList.add("open");
    }

    function openOwnerLogin() {
      const pin = prompt("Owner PIN enter karein (Default: 1234):");
      if (pin !== OWNER_PIN) {
        alert("Galat PIN!");
        return;
      }
      renderOwnerPanel();
      document.getElementById("ownerModal").classList.add("open");
    }

    function renderOwnerPanel() {
      document.getElementById("statTotalUsers").innerText = "1";
      document.getElementById("statStatus").innerText = userAccount.verificationStatus;
      document.getElementById("statPaid").innerText = userAccount.hasWeeklyPlan ? "₹250" : "No";

      document.getElementById("ownerUserCard").innerHTML = `
        <h4 style="margin-bottom:8px;">User Verification Request</h4>
        <p style="font-size:0.85rem; line-height:1.5; color:#ddd;">
          <strong>Name:</strong> ${userAccount.name}<br/>
          <strong>ID Type:</strong> ${userAccount.idType}<br/>
          <strong>ID Ref:</strong> ${userAccount.idNumber || "Not entered"}<br/>
          <strong>Status:</strong> ${userAccount.verificationStatus}
        </p>
        <div class="action-row">
          <button class="btn btn-success" onclick="setOwnerApproval('Verified')">Approve (Unlock Chat)</button>
          <button class="btn btn-danger" onclick="setOwnerApproval('Rejected')">Reject</button>
        </div>
      `;
    }

    function setOwnerApproval(newStatus) {
      userAccount.verificationStatus = newStatus;
      saveAccount();
      renderOwnerPanel();
      alert(`User status updated to: ${newStatus}`);
    }

    function setFilter(type, btn) {
      currentFilter = type;
      document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
      btn.classList.add("active");
      renderGrid();
    }

    function switchTab(tab, btn) {
      document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      document.getElementById("tab-nearby").style.display = tab === "nearby" ? "block" : "none";
      document.getElementById("tab-chats").classList.toggle("active", tab === "chats");
      document.getElementById("tab-me").classList.toggle("active", tab === "me");
      if (tab === "chats") renderInbox();
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove("open");
    }

    document.getElementById("myName").value = userAccount.name;
    document.getElementById("idType").value = userAccount.idType;
    document.getElementById("idNumber").value = userAccount.idNumber;
    updateTopUI();
    renderGrid();
  </script>
</body>
</html>
